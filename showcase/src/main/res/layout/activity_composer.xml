<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="New download"
            android:textColor="@color/paper"
            android:textSize="20sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/engine"
            style="@style/Widget.Fetch.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Engine" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Fetch.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Links" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Fetch.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="One address per line">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/links"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textUri"
                    android:minLines="4"
                    android:textColor="@color/paper" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/detected"
                    style="@style/Text.Fetch.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No link yet. Paste one address, or several." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/paste"
                    style="@style/Widget.Fetch.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paste" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/fileNameLayout"
                style="@style/Widget.Fetch.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="File name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/fileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/paper" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/landing"
                style="@style/Text.Fetch.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                style="@style/Text.Fetch.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="When" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/whenGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/whenNow"
                    style="@style/Widget.Fetch.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Now" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/whenMinutes"
                    style="@style/Widget.Fetch.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In a few minutes" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/whenDate"
                    style="@style/Widget.Fetch.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="On a date" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/whenWeek"
                    style="@style/Widget.Fetch.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weekday" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/whenRepeat"
                    style="@style/Widget.Fetch.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repeat" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/whenHelp"
                style="@style/Text.Fetch.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:id="@+id/panelMinutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Fetch.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Minutes from now">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/minutes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="15"
                        android:textColor="@color/paper" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pickDate"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Date"
                    android:textAllCaps="false"
                    android:textColor="@color/paper"
                    app:strokeColor="@color/line" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pickTime"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Time"
                    android:textAllCaps="false"
                    android:textColor="@color/paper"
                    app:strokeColor="@color/line" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelWeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/weekGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/daySun"
                        style="@style/Widget.Fetch.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sun" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/dayMon"
                        style="@style/Widget.Fetch.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mon" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/dayTue"
                        style="@style/Widget.Fetch.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tue" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/dayWed"
                        style="@style/Widget.Fetch.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wed" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/dayThu"
                        style="@style/Widget.Fetch.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thu" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/dayFri"
                        style="@style/Widget.Fetch.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fri" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/daySat"
                        style="@style/Widget.Fetch.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sat" />
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pickWeekTime"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Time"
                    android:textAllCaps="false"
                    android:textColor="@color/paper"
                    app:strokeColor="@color/line" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelRepeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Fetch.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Repeat every N minutes">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/repeatMinutes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="60"
                        android:textColor="@color/paper" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/clockBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Text.Fetch.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Clock" />

                <TextView
                    style="@style/Text.Fetch.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="WorkManager waits in the background. AlarmManager can wake the phone. If an exact alarm is not allowed, the library uses an inexact one." />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/clockGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/clockWork"
                        style="@style/Widget.Fetch.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="WorkManager" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/clockAlarm"
                        style="@style/Widget.Fetch.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AlarmManager" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <TextView
                style="@style/Text.Fetch.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Request" />

            <TextView
                style="@style/Text.Fetch.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="These travel with every link in the box. Cookie is just a header named Cookie." />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Fetch.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Cookie">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/cookie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/paper" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Fetch.TextInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="Header">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/headerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/paper" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Fetch.TextInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Value">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/headerValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/paper" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                style="@style/Text.Fetch.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Byte window" />

            <TextView
                style="@style/Text.Fetch.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Both ends are inclusive. Leave them empty for the whole file. The saved file starts at local byte zero, and the checksum covers that window." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Fetch.TextInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="First byte">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/rangeStart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/paper" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Fetch.TextInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Last byte">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/rangeEnd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/paper" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                style="@style/Text.Fetch.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Checksum" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/checksumGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/sum256"
                    style="@style/Widget.Fetch.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="SHA-256" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/sum512"
                    style="@style/Widget.Fetch.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHA-512" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/sumMd5"
                    style="@style/Widget.Fetch.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MD5" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/checksumLayout"
                style="@style/Widget.Fetch.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Checksum, or leave empty">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/checksum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/paper" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/start"
        style="@style/Widget.Fetch.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="20dp"
        android:text="Start now" />
</LinearLayout>
