<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/bubblePanel"
        android:layout_width="248dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:background="@drawable/bubble_panel_bg"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/bubbleRank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Scout"
            android:textColor="@color/copper"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/bubbleHaul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/paper"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bubbleToward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/bubbleActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Nothing moving"
            android:textColor="@color/paper"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/bubbleProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_fetch" />

        <EditText
            android:id="@+id/bubbleLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bubble_field"
            android:hint="Drop a link"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:padding="10dp"
            android:textColor="@color/paper"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bubblePaste"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bubble_chip"
                android:drawableStart="@drawable/ic_paste"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Copied"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/bubbleStart"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bubble_chip"
                android:gravity="center"
                android:text="Start"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Drag the orb. Flick it up to open, down to close."
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <com.miaadrajabi.fetch.BubbleOrb
        android:id="@+id/bubbleOrb"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="Fetch" />

    <TextView
        android:id="@+id/bubblePop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="46dp"
        android:fontFamily="sans-serif-medium"
        android:text="+1"
        android:textColor="@color/copper"
        android:textSize="16sp"
        android:visibility="gone" />
</FrameLayout>
